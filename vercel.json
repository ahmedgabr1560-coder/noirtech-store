{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, x-admin-secret"
        }
      ]
    },
    {
      "source": "/(styles.css|script.js|styles-ai-btn.css|config-loader.js|go-home-patch.js|favicon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/product-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(products.json|categories.json|site-config.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=120, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=120, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/admin.js": {
      "maxDuration": 20,
      "memory": 512
    },
    "api/product.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/notify.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/checkout.js": {
      "maxDuration": 20,
      "memory": 256
    },
    "api/track.js": {
      "maxDuration": 15,
      "memory": 256
    }
  }
}
